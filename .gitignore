# =============================================================
# CROWSNEST PORTFOLIO — .gitignore
# Este repo es público: nunca versionar credenciales ni datos reales
# =============================================================

# API Keys
.env
*.env
.env.*
!.env.example

# Datos reales de targets y resultados de escaneo — NUNCA en este repo
db/
targets/
reportes/
results/

# Configuraciones con API keys incrustadas.
# El template versionado es config/provider-config.example.yaml; copialo a
# config/provider-config.yaml y rellena tus keys ahi.
config/provider-config.yaml
config/amass/
config/nuclei/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OpenClaw — caches locales
openclaw/.crawl4ai_cache/
openclaw/.crawl4ai/
.crawl4ai/

# Temporales y backups
*.tmp
*.log
*.bak
*.backup_*

# Sistema operativo
.DS_Store
Thumbs.db

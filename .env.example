# =============================================================================
# SINS WORKSTATION — Variables de entorno y API Keys
# Copia este archivo a .env y reemplaza cada placeholder por tu valor real.
# NUNCA subas el .env al repositorio (ya está en .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# SUBFINDER — APIs para descubrimiento de subdominios
# Documentación: https://github.com/projectdiscovery/subfinder#api-keys
# ---------------------------------------------------------------------------
SHODAN_API_KEY=tu_shodan_api_key_aqui
CENSYS_API_ID=tu_censys_api_id_aqui
CENSYS_API_SECRET=tu_censys_api_secret_aqui
GITHUB_TOKEN=tu_github_personal_access_token_aqui
CHAOS_KEY=tu_chaos_key_aqui                 # ProjectDiscovery Chaos dataset
SECURITYTRAILS_KEY=tu_securitytrails_key_aqui
BINARYEDGE_KEY=tu_binaryedge_key_aqui
VIRUSTOTAL_KEY=tu_virustotal_key_aqui
FULLHUNT_KEY=tu_fullhunt_key_aqui
ZOOMEYE_KEY=tu_zoomeye_key_aqui

# ---------------------------------------------------------------------------
# H8MAIL — Búsqueda de credenciales filtradas
# ---------------------------------------------------------------------------
HIBP_API_KEY=tu_hibp_key_aqui               # HaveIBeenPwned (plan de pago)
DEHASHED_KEY=tu_dehashed_key_aqui
LEAKOSINT_KEY=tu_leakosint_key_aqui

# ---------------------------------------------------------------------------
# SHODAN CLI — Consultas directas desde terminal
# ---------------------------------------------------------------------------
SHODAN_KEY=tu_shodan_api_key_aqui           # Mismo key que subfinder

# ---------------------------------------------------------------------------
# THEHARVESTER — Fuentes adicionales
# ---------------------------------------------------------------------------
BING_KEY=tu_bing_key_aqui

# ---------------------------------------------------------------------------
# NUCLEI — ProjectDiscovery Cloud (opcional, para templates privados)
# ---------------------------------------------------------------------------
PDCP_API_KEY=tu_pdcp_key_aqui

# ---------------------------------------------------------------------------
# AMASS — APIs adicionales para mapeo de activos
# ---------------------------------------------------------------------------
WHOISXML_KEY=tu_whoisxml_key_aqui
PASSIVETOTAL_USER=tu_usuario_aqui
PASSIVETOTAL_KEY=tu_passivetotal_key_aqui

# ---------------------------------------------------------------------------
# OPENCLAW — Orquestador de agentes LLM
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OPENCLAW_PROSPECTOS_DB=                     # ruta al JSON de prospectos
                                            # ej: /home/usuario/proyecto/db/prospectos.json
OPENCLAW_REPORTES_DIR=                      # ruta de salida de reportes

# ---------------------------------------------------------------------------
# WEBAPP — Panel Flask
# Si se dejan vacías, la app genera valores aleatorios y los escribe en .env
# ---------------------------------------------------------------------------
WEBAPP_PASSWORD=tu_password_del_panel_aqui
WEBAPP_SECRET_KEY=genera_una_key_hex_larga_y_aleatoria_aqui
